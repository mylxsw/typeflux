{
  "schema": 1,
  "id": "local.code",
  "name": "@L:code.name",
  "description": "@L:code.summary",
  "icon": "sf:chevron.left.forwardslash.chevron.right",
  "version": "1.0.0",
  "author": "Typeflux",
  "keywords": [
    {
      "keyword": "code",
      "title": "@L:code.keyword.code",
      "options": { "roots": "~/Projects ~/Code ~/Developer ~/src ~/GitHub", "editor": "" }
    }
  ],
  "input": { "argument": "optional", "selection": "never" },
  "run": { "mode": "onSubmit", "timeoutSeconds": 5 },
  "command": { "runtime": "zsh", "script": "main.sh", "args": ["{query}"] },
  "output": "items"
}
