{
  "schema": 1,
  "id": "local.uuid",
  "name": "@L:uuid.name",
  "description": "@L:uuid.summary",
  "icon": "sf:number",
  "version": "1.0.0",
  "author": "Typeflux",
  "keywords": [
    { "keyword": "uuid", "title": "@L:uuid.keyword.uuid", "options": { "kind": "uuid" } },
    { "keyword": "pwd", "title": "@L:uuid.keyword.pwd", "options": { "kind": "password" } }
  ],
  "input": { "argument": "optional", "selection": "never" },
  "run": { "mode": "onSubmit", "timeoutSeconds": 5 },
  "command": { "runtime": "zsh", "script": "main.sh", "args": ["{query}"] },
  "output": {
    "display": "none",
    "onSuccess": [
      { "action": "copy", "value": "{output}" },
      { "action": "hud", "text": "@L:uuid.copied" }
    ],
    "close": true
  }
}
